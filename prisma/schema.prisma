// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id @default(cuid())
  name      Json // { th, en, ja }
  order     Int
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Experience {
  id          String   @id @default(cuid())
  type        String // "work" | "education"
  title       Json // { th, en, ja }
  company     String
  startDate   String // "yyyy-MM"
  endDate     String? // "yyyy-MM", null = Present
  isCurrent   Boolean  @default(false)
  description Json // { th, en, ja }
  skills      String[]
  icon        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("experiences")
}

model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  order            Int
  title            Json // { th, en, ja }
  description      Json // { th, en, ja }
  tags             Json // { th: string[], en: string[], ja: string[] } — badge บนหน้า detail header, คำแปลต่างกันจริง เช่น "Management"/"การจัดการ"/"管理"
  filterTags       String[] // controlled vocabulary: web | crossplatform | mobile | desktop | backend — ใช้ filter หน้า /portfolio list (ไม่ต้องแปล)
  techSummary      String // one-liner บนการ์ด list/showcase เช่น "Flutter, Node.js, Express, Prisma, MySQL" (ไม่แปล เป็นชื่อเทคโนโลยี)
  thumbnailUrl     String // การ์ดหน้า /portfolio list
  overviewImageUrl String // hero image ใน tab Overview
  overviewImageAlt Json // { th, en, ja }
  repoUrl          String?
  demoUrl          String?
  liveUrl          String?
  duration         Json // { th, en, ja } — เช่น "6 months"/"6 เดือน"/"6ヶ月"
  status           Json // { th, en, ja } — เช่น "In Development"/"กำลังพัฒนา"/"開発中"
  company          String // ชื่อบริษัท ไม่แปล
  technologies     String[] // infoBar เต็ม (คนละชุดกับ techSummary จริง ๆ ในข้อมูลเดิม)
  content          Json // { overview, features, gallery, technical, results, futureGoals } — ดู cms-schema.md
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("projects")
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  icon        String
  url         String?
  description Json // { th, en, ja }
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  order       Int
  featured    Boolean  @default(false)
  active      Boolean  @default(true) // false = แสดงในหน้า admin เท่านั้น ยังไม่โชว์หน้า public (ระหว่างศึกษา/ยังไม่มั่นใจ)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("skills")
}
