# App runtime — Supabase transaction pooler (also use this on Vercel).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI migrations — session pooler or direct connection, not transaction mode.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Supabase project
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Supabase Dashboard → Settings → API → anon/public key. Safe to expose client-side.
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Supabase Dashboard → Settings → API → service_role key. Server-only, never expose client-side.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# The only Google account allowed into /admin — checked server-side after OAuth,
# anyone else who signs in with Google gets signed back out immediately.
ADMIN_EMAIL="you@example.com"
